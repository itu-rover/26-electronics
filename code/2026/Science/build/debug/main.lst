 146:Core/Src/main.c ****   /* USER CODE BEGIN 2 */
 147:Core/Src/main.c **** 
 148:Core/Src/main.c ****   //PWM input in interrupt mode
 149:Core/Src/main.c ****   HAL_TIM_IC_Start_IT(&htim4, TIM_CHANNEL_1); // Rising edge
 150:Core/Src/main.c ****   HAL_TIM_IC_Start_IT(&htim4, TIM_CHANNEL_2); // Falling edge
 151:Core/Src/main.c **** 
 152:Core/Src/main.c ****   //HAL_Delay(1000); // wait to pass unstable status of the sensors (DHT11)
 153:Core/Src/main.c ****   /* USER CODE END 2 */
 154:Core/Src/main.c **** 
 155:Core/Src/main.c ****   /* Infinite loop */
 156:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 157:Core/Src/main.c ****   while (1)
 158:Core/Src/main.c ****   {
 159:Core/Src/main.c ****     //HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, 1);
 160:Core/Src/main.c ****     /* USER CODE END WHILE */
 161:Core/Src/main.c **** 
 162:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 163:Core/Src/main.c **** 	  DHT11_Start();
 164:Core/Src/main.c **** 	  presence = DHT11_Check_Response();
 165:Core/Src/main.c **** 
 166:Core/Src/main.c **** 	  if (presence) {
 167:Core/Src/main.c **** 		  RhByteInt   = DHT11_Read_Byte();			//Nem: tam kısım
 168:Core/Src/main.c **** 		  RhByteDec   = DHT11_Read_Byte();			//Nem: ondalıklı kısım (sıfır geliyo)
 169:Core/Src/main.c **** 		  TempByteInt = DHT11_Read_Byte();			//Sıcaklık: tam kısım
 170:Core/Src/main.c **** 		  TempByteDec = DHT11_Read_Byte();			//Sıcaklık: ondalıklı kısım
 171:Core/Src/main.c **** 		  SumCheck    = DHT11_Read_Byte();			//Önemsiz
 172:Core/Src/main.c **** 	  }
 173:Core/Src/main.c **** 	  DHT_temp 	   = TempByteInt +  TempByteDec / 10.0f;
 174:Core/Src/main.c **** 
 175:Core/Src/main.c **** 	  NH3 = Read_NH3();
 176:Core/Src/main.c **** 	  CH4 = Read_CH4();
 177:Core/Src/main.c **** 	  NO2 = Read_NO2();
 178:Core/Src/main.c **** 
 179:Core/Src/main.c **** 	  UT = get_ut();
 180:Core/Src/main.c **** 	  UP = get_up();
 181:Core/Src/main.c **** 	  temp = get_temp();
 182:Core/Src/main.c **** 	  press= get_press() * 10 * 50;
 183:Core/Src/main.c **** 
 184:Core/Src/main.c **** 	  snprintf(data_buff, sizeof(data_buff), "%f %f %f %f %f %u %ld",
 185:Core/Src/main.c **** 		CO2, NH3, CH4, NO2, DHT_temp, RhByteInt, press);
 186:Core/Src/main.c **** 
 187:Core/Src/main.c **** 	  HAL_UART_Transmit(&huart5, (uint8_t*)data_buff, strlen(data_buff), HAL_MAX_DELAY);
 188:Core/Src/main.c **** 	  HAL_UART_Transmit(&huart2, (uint8_t*)data_buff, strlen(data_buff), HAL_MAX_DELAY);
 189:Core/Src/main.c **** 
 190:Core/Src/main.c **** 	  HAL_Delay(1500);
 191:Core/Src/main.c **** 
 192:Core/Src/main.c **** 
 193:Core/Src/main.c ****   }
 194:Core/Src/main.c ****   /* USER CODE END 3 */
 195:Core/Src/main.c **** }
