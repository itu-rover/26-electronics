  95:Core/Src/main.c **** 
  96:Core/Src/main.c **** //MHZ-19 Callback Function
  97:Core/Src/main.c **** void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim){
  98:Core/Src/main.c **** 	if(htim->Channel==HAL_TIM_ACTIVE_CHANNEL_1)
  99:Core/Src/main.c **** 	{
 100:Core/Src/main.c **** 		period_tick = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_1);
 101:Core/Src/main.c **** 		high_tick = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_2);
 102:Core/Src/main.c **** 	}
 103:Core/Src/main.c **** 	high_ms = high_tick * TICK_MS;
 104:Core/Src/main.c **** 	period_ms = period_tick * TICK_MS;
 105:Core/Src/main.c **** 	CO2 = 2000 * (high_ms - 2) / (period_ms - 4) + 240 ;
 106:Core/Src/main.c **** }
 107:Core/Src/main.c **** 
 108:Core/Src/main.c **** /* USER CODE END 0 */
