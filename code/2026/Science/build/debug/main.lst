 149:Core/Src/main.c ****   //PWM input in interrupt mode
 150:Core/Src/main.c ****   HAL_TIM_IC_Start_IT(&htim4, TIM_CHANNEL_1); // Rising edge
 151:Core/Src/main.c ****   HAL_TIM_IC_Start_IT(&htim4, TIM_CHANNEL_2); // Falling edge
 152:Core/Src/main.c **** 
 153:Core/Src/main.c ****   //HAL_Delay(1000); // wait to pass unstable status of the sensors (DHT11)
 154:Core/Src/main.c ****   /* USER CODE END 2 */
 155:Core/Src/main.c **** 
 156:Core/Src/main.c ****   /* Infinite loop */
 157:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 158:Core/Src/main.c ****   while (1)
 159:Core/Src/main.c ****   {
 160:Core/Src/main.c ****     //HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, 1);
 161:Core/Src/main.c ****     /* USER CODE END WHILE */
 162:Core/Src/main.c **** 
 163:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 164:Core/Src/main.c **** 	  DHT11_Start();
 165:Core/Src/main.c **** 	  presence = DHT11_Check_Response();
 166:Core/Src/main.c **** 
 167:Core/Src/main.c **** 	  if (presence) {
 168:Core/Src/main.c **** 		  RhByteInt   = DHT11_Read_Byte();			//Nem: tam kısım
 169:Core/Src/main.c **** 		  RhByteDec   = DHT11_Read_Byte();			//Nem: ondalıklı kısım (sıfır geliyo)
 170:Core/Src/main.c **** 		  TempByteInt = DHT11_Read_Byte();			//Sıcaklık: tam kısım
 171:Core/Src/main.c **** 		  TempByteDec = DHT11_Read_Byte();			//Sıcaklık: ondalıklı kısım
 172:Core/Src/main.c **** 		  SumCheck    = DHT11_Read_Byte();			//Önemsiz
 173:Core/Src/main.c **** 	  }
 174:Core/Src/main.c **** 	  DHT_temp 	   = TempByteInt +  TempByteDec / 10.0f;
 175:Core/Src/main.c **** 
 176:Core/Src/main.c **** 	  NH3 = Read_NH3();
 177:Core/Src/main.c **** 	  CH4 = Read_CH4();
 178:Core/Src/main.c **** 	  NO2 = Read_NO2();
 179:Core/Src/main.c **** 
 180:Core/Src/main.c **** 	  UT = get_ut();
 181:Core/Src/main.c **** 	  UP = get_up();
 182:Core/Src/main.c **** 	  temp = get_temp();
 183:Core/Src/main.c **** 	  press= get_press() * 10 * 50;
 184:Core/Src/main.c **** 
 185:Core/Src/main.c ****     // CO2: 3 decimal places
 186:Core/Src/main.c ****     uint32_t CO2_whole = (uint32_t) CO2;
 187:Core/Src/main.c ****     uint32_t CO2_decimal = (uint32_t)((CO2 - CO2_whole) * 1000);
 188:Core/Src/main.c **** 
 189:Core/Src/main.c ****     // Gases: 5 decimal places
 190:Core/Src/main.c ****     uint32_t NH3_whole = (uint32_t) NH3;
 191:Core/Src/main.c ****     uint32_t NH3_decimal = (uint32_t)((NH3 - NH3_whole) * 100000);
 192:Core/Src/main.c **** 
 193:Core/Src/main.c ****     uint32_t CH4_whole = (uint32_t) CH4;
 194:Core/Src/main.c ****     uint32_t CH4_decimal = (uint32_t)((CH4 - CH4_whole) * 100000);
 195:Core/Src/main.c **** 
 196:Core/Src/main.c ****     uint32_t NO2_whole = (uint32_t) NO2;
 197:Core/Src/main.c ****     uint32_t NO2_decimal = (uint32_t)((NO2 - NO2_whole) * 100000);
 198:Core/Src/main.c **** 
 199:Core/Src/main.c ****     // Temperature: Signed (int32_t) to handle negative temperatures safely (not used)
 200:Core/Src/main.c ****     // Note: We didn't use absolute value for the decimal portion so negative temps format correctl
 201:Core/Src/main.c ****     uint32_t DHT_temp_whole = (uint32_t) DHT_temp;
 202:Core/Src/main.c ****     uint32_t DHT_temp_decimal = (uint32_t)((DHT_temp - DHT_temp_whole) * 100000);
